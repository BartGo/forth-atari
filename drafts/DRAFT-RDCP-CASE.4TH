( RDCP decompiler )
( see also DISFORTHer FDv10n2 )
( w/ CASE BY C. EAKER FD V02N03 P 36 )

: CASES
  ?COMP CSP @ !CSP
  4 ; IMMEDIATE
: CASE
  4 ?PAIRS
  COMPILE OVER
  COMPILE = 
  COMPILE 0BRANCH
  HERE 0 ,
  COMPILE DROP
  5 ; IMMEDIATE
: IS
  5 ?PAIRS
  COMPILE BRANCH HERE 0 ,
  SWAP 2 [COMPILE] ENDIF
  4 ; IMMEDIATE
: END-CASES 
  4 ?PAIRS 
  COMPILE DROP
  BEGIN
    SP@ CSP @ = 0=
  WHILE
    2 [COMPILE] ENDIF
  REPEAT 
  CSP ! ; IMMEDIATE  
    
  

( RDCP )

HEX
0 VARIABLE GIN
0 VARIABLE BASESAV
0 VARIABLE KEYSW
0 VARIABLE RDFEN
' C/L  2 - @ CONSTANT CONST.ADR
' BASE 2 - @ CONSTANT USERV.ADR
' GIN  2 - @ CONSTANT VAR.ADR
: U. 0 D. ;
: GOV OVER @ 2+ ;
: 2+D 2+ DUP ;
: .G@ 0 4 D.R GIN @ ;
: DIN CR DUP .G@ SPACES ;
: GIN+ CR OVER .G@ 2+D GIN ! SPACES ;
: MYSELF LATEST PFA CFA , ; IMMEDIATE

: GCHKTYP ( pfa -- f )
  CASES ' LIT    CASE 1 IS
       ' BRANCH  CASE 1 IS
       ' 0BRANCH CASE 1 IS
       ' (LOOP)  CASE 1 IS
       ' (+LOOP) CASE 1 IS
       0 SWAP 
  END-CASES ;

: 1KEY KEYSW @
  IF ?TERMINAL IF ASCII Q
  ELSE DUP RDFEN @ U<
  IF BL ELSE CR THEN THEN
  ELSE KEY THEN ;

: GCHK ( pfa -- pfa2 )
  1 CASES GOV ' COMPILE =
    CASE 2+D @ 2+ NFA ID. IS
       GOV GCHKTYP
    CASE 2+D @ SPACE U. IS
       GOV ' (.") =
    CASE 2+D COUNT TYPE
      DUP C@ 1 - + IS
  END-CASES 2+ -2 GIN +! ;
 
: CK: DUP CFA @ ' : CFA @ = ;

: DISTYPE ( nfa -- )
  DUP C@ 40 AND ( immediate bit )
  IF ." [COMPILE] " ID.
  ELSE DUP ID. PFA CFA DUP @
    CASES
      CONST.ADR CASE ." const "
        EXECUTE U. IS
      VAR.ADR   CASE ." var " 
        EXECUTE @ U. IS
      USERV.ADR CASE ." user "
        EXECUTE @ U. IS
      DROP
    END-CASES THEN ;

: (GOESINTO) ( pfa -- )
  CK: IF
    2 - DIN ."   :" 2+D
    NFA C@ 40 AND IF
  	  ."  IMMEDIATE"
	THEN
    BEGIN
 	  DUP @ DUP ' ;S CFA =
 	  OVER ' (;CODE) CFA = OR 0=
    WHILE
 	  2+ GIN+ DUP NFA DISTYPE
 	  1KEY CASES
 	    ASCII Q CASE
 	  	  SP! BASESAV @
 	  	  BASE ! QUIT IS
 	    155 ( CR ) CASE
 	  	  MYSELF IS
 	    ASCII U CASE
 	  	  DROP DROP R>
 	  	  DROP -2 GIN +! IS
 	    DROP
 	  END-CASES
 	  GCHK
    REPEAT CR
    GIN @ 6 + SPACES 2+ NFA ID.
  THEN DROP ;   
  

: RDCP
  BASE @ BASESAV ! HEX
  -FIND
  IF DROP 0 GIN ! CK:
    IF (GOESINTO)
    ELSE NFA DISTYPE
    THEN
  ELSE ." Not in Dictionary"
  THEN 
  CR BASESAV @ BASE ! ;
 
HERE RDFEN ! DECIMAL
;S
